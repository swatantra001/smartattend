{
  "cli": { "version": ">= 7.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.114.10.185:4000/api",
        "EXPO_PUBLIC_WS_URL": "http://10.114.10.185:4000"
      }
    },
    "staging": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.smartattend.yourdomain.com/api",
        "EXPO_PUBLIC_WS_URL": "https://api.smartattend.yourdomain.com"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      },
      "ios": {
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.smartattend.yourdomain.com/api",
        "EXPO_PUBLIC_WS_URL": "https://api.smartattend.yourdomain.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "your@apple.id",
        "ascAppId": "your-app-store-connect-app-id"
      }
    }
  }
}