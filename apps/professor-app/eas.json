{
  "cli": { "version": ">= 7.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.114.10.185:4000/api",
        "EXPO_PUBLIC_WS_URL": "http://10.114.10.185:4000"
      }
    },
    "staging": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.114.10.185:4000/api",
        "EXPO_PUBLIC_WS_URL": "http://10.114.10.185:4000"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.114.10.185:4000/api",
        "EXPO_PUBLIC_WS_URL": "http://10.114.10.185:4000"
      }
    }
  }
}